<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#397C68</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">#F3F4F1</item>
        <item name="android:navigationBarColor">#F3F4F1</item>
        <item name="android:windowBackground">#F3F4F1</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="AppTheme.Dark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#95D3BC</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">#131715</item>
        <item name="android:navigationBarColor">#131715</item>
        <item name="android:windowBackground">#131715</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
